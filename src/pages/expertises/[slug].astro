---
import ServiceDetail from '../../views/ServiceDetail.astro'
import { services, type Service } from '../../data/services'

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug.fr }, props: { service } }))
}
const { service } = Astro.props as { service: Service }
---

<ServiceDetail lang="fr" service={service} />
