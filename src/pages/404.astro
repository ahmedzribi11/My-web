---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
// Une seule page 404 pour les deux langues (l’hébergeur sert la même page pour /… et /en/…) :
// texte français puis anglais, chaque partie avec sa langue déclarée (I18N-06, A11Y-11).
---

<Base lang="fr" alt="/en" title="Page introuvable · Page not found" noindex>
  <section class="relative flex min-h-svh items-center overflow-hidden">
    <div class="css-fog" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="wrap relative grid gap-14 py-32 md:grid-cols-2 md:gap-10">
      <div>
        <p class="label text-gold">Erreur 404</p>
        <h1 class="display mt-8 text-display">Page <em class="serif text-gold">introuvable.</em></h1>
        <p class="mt-6 max-w-lg text-lead text-bone/75">Cette page n’existe pas ou a été déplacée.</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/" class="btn btn-gold">Accueil <Icon name="arrow" /></a>
          <a href="/realisations" class="btn btn-line">Réalisations</a>
        </div>
      </div>
      <div lang="en">
        <p class="label text-gold">Error 404</p>
        <h2 class="display mt-8 text-display">Page <em class="serif text-gold">not found.</em></h2>
        <p class="mt-6 max-w-lg text-lead text-bone/75">This page does not exist or has moved.</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/en" class="btn btn-gold">Home <Icon name="arrow" /></a>
          <a href="/en/projects" class="btn btn-line">Projects</a>
        </div>
      </div>
    </div>
  </section>
</Base>
