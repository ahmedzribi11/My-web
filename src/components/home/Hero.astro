---
import Icon from '../Icon.astro'
import { route, TYPE_LABELS, useT, type Lang } from '../../i18n'
import { pageWhatsApp } from '../../lib/settings'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
const types = ['villas', 'residences', 'hotels', 'immeubles', 'industrie', 'infrastructures'].map((k) => TYPE_LABELS[k][lang])
const wa = pageWhatsApp(lang)
---

<section id="hero" class="relative min-h-[640px] overflow-hidden bg-ink md:h-svh" aria-labelledby="hero-title">
  <div class="absolute inset-0" aria-hidden="true">
    <div class="css-fog opacity-80"><span></span><span></span><span></span></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_68%_38%,rgba(5,46,20,0.55),transparent_60%)]"></div>
    <canvas data-hero-canvas class="absolute inset-0 h-full w-full"></canvas>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_45%,transparent_35%,rgba(7,12,9,0.85)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-[72%] bg-gradient-to-t from-ink via-ink/80 to-transparent md:h-[58%] md:via-ink/75"></div>
  </div>

  <div class="wrap relative flex min-h-[640px] flex-col justify-end pb-10 pt-24 md:h-full md:pb-14 md:pt-32">
    <p class="label text-gold">{t('hero.kicker')}</p>

    <div class="mt-6 grid items-end gap-8 md:mt-auto lg:grid-cols-12 lg:gap-10">
      <h1 id="hero-title" class="display text-display lg:col-span-8">
        {t('hero.title1')} <em class="serif text-gold">{t('hero.title2')}</em>
        <span class="block">{t('hero.title3')}</span>
      </h1>

      <div class="flex flex-col gap-6 lg:col-span-4 lg:pb-3">
        <p class="max-w-md text-body text-bone/85">{t('hero.lead')}</p>
        <div class="flex flex-wrap gap-3">
          <a href={route('projects', lang)} class="btn btn-gold">
            {t('cta.projects')} <Icon name="arrow" />
          </a>
          <a href={wa || route('contact', lang)} target={wa ? '_blank' : undefined} rel={wa ? 'noopener' : undefined} class="btn btn-line">
            {wa && <Icon name="whatsapp" size={16} />}
            {t('cta.project')}
          </a>
        </div>
      </div>
    </div>

    <p class="mt-10 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-t border-line pt-5 text-small text-bone/80">
      <span class="meta text-mist">{t('hero.we')}</span>
      {types.join(' · ')}
    </p>
  </div>
</section>

<script>
  import '../../scripts/hero'
</script>
