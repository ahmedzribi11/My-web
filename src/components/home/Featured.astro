---
import ProjectImage from '../ProjectImage.astro'
import ProjectCard from '../ProjectCard.astro'
import SectionHead from '../SectionHead.astro'
import Icon from '../Icon.astro'
import { projectPath, route, STATUS_SHORT, useT, type Lang } from '../../i18n'
import { pad, type Project } from '../../lib/projects'

interface Props {
  lang: Lang
  featured: Project[]
}
const { lang, featured } = Astro.props
const t = useT(lang)
const [lead, ...rest] = featured
---

<section id="featured" class="relative bg-ink py-20 md:py-32" aria-labelledby="featured-title">
  <div class="wrap">
    <SectionHead id="featured-title" label={t('featured.label')} title={t('featured.title')} accent={lang === 'fr' ? 'pour nous.' : 'for us.'} />

    {
      lead && (
        <a href={projectPath(lead.slug, lang)} class="group mt-12 grid gap-6 md:mt-16 md:grid-cols-12 md:gap-10" data-reveal>
          <div class="relative aspect-[4/3] overflow-hidden bg-ink-3 md:col-span-8 md:aspect-[16/10]">
            <ProjectImage image={lead.images[0]} sizes="(min-width: 768px) calc((100vw - 5rem) * 0.64), calc(100vw - 2.5rem)" class="block h-full w-full" imgClass="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" vt={`p-${lead.slug}`} priority={false} />
            <div class="absolute left-4 top-4 flex gap-2">
              {lead.status && <span class="pill" data-status={lead.status}>{STATUS_SHORT[lead.status][lang]}</span>}
              {lead.images[0].kind !== 'photo' && <span class="pill" data-kind={lead.images[0].kind}>{lead.images[0].kind === 'render' ? t('project.render') : t('project.plan')}</span>}
            </div>
          </div>
          <div class="flex flex-col justify-between md:col-span-4">
            <div>
              <p class="meta text-gold">N° {pad(lead.number)}</p>
              <h3 class="display mt-4 text-title transition-colors duration-200 group-hover:text-gold">{lead.name}</h3>
              <p class="mt-4 max-w-sm text-body text-bone/80">{lead.composition}</p>
            </div>
            <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-line pt-5">
              <div>
                <dt class="meta text-mist">{t('project.location')}</dt>
                <dd class="mt-1 text-body">{lead.location}</dd>
              </div>
              <div>
                <dt class="meta text-mist">{t('project.period')}</dt>
                <dd class="mt-1 text-body">{lead.period}</dd>
              </div>
              {lead.surface && (
                <div>
                  <dt class="meta text-mist">{t('project.surface')}</dt>
                  <dd class="mt-1 text-body">{lead.surface}</dd>
                </div>
              )}
            </dl>
            <span class="meta mt-6 inline-flex items-center gap-2 text-bone">
              {t('cta.discover')} <span class="sr-only">{lead.name}</span> <Icon name="arrow" />
            </span>
          </div>
        </a>
      )
    }

    <div class="mt-16 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((p) => <ProjectCard project={p} lang={lang} sizes="(min-width: 1024px) calc((100vw - 8rem) / 3), (min-width: 640px) calc((100vw - 5rem) / 2), calc(100vw - 2.5rem)" />)}
    </div>

    <div class="mt-14 flex justify-center">
      <a href={route('projects', lang)} class="btn btn-line">{t('cta.allProjects')} <Icon name="arrow" /></a>
    </div>
  </div>
</section>
