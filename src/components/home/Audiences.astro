---
import ProjectImage from '../ProjectImage.astro'
import SectionHead from '../SectionHead.astro'
import Icon from '../Icon.astro'
import { audiences } from '../../data/audiences'
import { route, useT, type Lang } from '../../i18n'
import { requireProject, type Project } from '../../lib/projects'

interface Props {
  lang: Lang
  projects: Project[]
}
const { lang, projects } = Astro.props
const t = useT(lang)
const by = (slug: string) => requireProject(projects, slug)
---

<section class="relative py-24 md:py-40" aria-labelledby="audiences-title">
  <div class="wrap">
    <SectionHead id="audiences-title" label={t('audiences.label')} title={t('audiences.title')} accent={lang === 'fr' ? 'notre métier.' : 'our craft.'} />

    <div class="audiences mt-16 flex flex-col gap-3 md:mt-24 md:h-[78vh] md:min-h-[560px] md:flex-row">
      {
        audiences.map((a, i) => (
          <a
            href={`${route('invest', lang)}#${a.id}`}
            class="audience group relative flex min-h-[420px] flex-1 overflow-hidden bg-ink-3 md:min-h-0"
            data-reveal
           
          >
            <ProjectImage image={by(a.image).images[0]} alt="" sizes="(min-width: 768px) 50vw, 100vw" class="absolute inset-0 block h-full w-full" imgClass="h-full w-full object-cover opacity-55 transition-[transform,opacity] duration-300 ease-[var(--ease-out)] group-hover:scale-[1.02] group-hover:opacity-40" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/60 to-ink/10" />
            <div class="relative mt-auto flex w-full flex-col p-6 md:p-8">
              <span class="meta text-gold">0{i + 1}</span>
              <h3 class="mt-3 text-title font-light tracking-[-0.03em]">{a.title[lang]}</h3>
              <div class="audience-body">
                <div class="overflow-hidden">
                  <p class="mt-5 max-w-md text-body text-bone/75">{a.text[lang]}</p>
                  <ul class="mt-5 flex flex-wrap gap-2">
                    {a.proof.slice(0, 3).map((s) => (
                      <li class="rounded-full border border-line bg-ink/40 px-3 py-1.5 text-label text-bone/80 backdrop-blur">{by(s).name}</li>
                    ))}
                  </ul>
                  <span class="meta mt-6 inline-flex items-center gap-2 text-bone">
                    {t('cta.more')} <Icon name="arrow" />
                  </span>
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .audience { transition: flex-grow 0.3s var(--ease-out); }
    .audiences:hover .audience { flex-grow: 0.75; }
    .audiences:hover .audience:hover { flex-grow: 2.2; }
    .audience-body { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 0.3s var(--ease-out), opacity 0.2s; }
    .audience:hover .audience-body, .audience:focus-visible .audience-body { grid-template-rows: 1fr; opacity: 1; }
  }
</style>
