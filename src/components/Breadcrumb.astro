---
/** Fil d’Ariane visible (le balisage BreadcrumbList correspondant est ajouté par la page). */
interface Props {
  items: { name: string; path: string }[]
  tone?: 'dark' | 'paper'
}
const { items, tone = 'dark' } = Astro.props
const lang = Astro.currentLocale === 'en' ? 'en' : 'fr'
---

<nav aria-label={lang === 'fr' ? 'Fil d’Ariane' : 'Breadcrumb'}>
  <ol class:list={['meta flex flex-wrap items-center gap-x-2 gap-y-1', tone === 'paper' ? 'text-brand/75' : 'text-bone/85']}>
    {
      items.map((it, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i < items.length - 1 ? (
            <a href={it.path} class="inline-flex min-h-6 items-center hover:text-gold">{it.name}</a>
          ) : (
            <span aria-current="page" class={tone === 'paper' ? 'text-brand' : 'text-gold'}>{it.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
