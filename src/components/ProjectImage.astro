---
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src: ImageMetadata
  alt: string
  sizes?: string
  class?: string
  imgClass?: string
  loading?: 'lazy' | 'eager'
  priority?: boolean
  /** Nom de transition de vue (morphing carte → page projet). */
  vt?: string
}
const { src, alt, sizes = '(min-width: 1024px) 50vw, 100vw', class: cls, imgClass = 'h-full w-full object-cover', loading = 'lazy', priority = false, vt } = Astro.props
const widths = [480, 960, 1600].filter((w) => w <= src.width)
if (!widths.includes(src.width) && src.width < 1600) widths.push(src.width)
---

<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['webp']}
  fallbackFormat="jpg"
  quality={78}
  loading={priority ? 'eager' : loading}
  fetchpriority={priority ? 'high' : undefined}
  decoding="async"
  class={imgClass}
  pictureAttributes={{ class: cls, style: vt ? `view-transition-name:${vt}` : undefined }}
/>
