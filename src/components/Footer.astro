---
import Icon from './Icon.astro'
import Logo from './Logo.astro'
import legal from '../data/legal.json'
import { route, useT, type Lang } from '../i18n'
import { contact, documents, documentLabel, socials, whatsappLink } from '../lib/settings'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
const year = new Date().getFullYear()
const nav = [
  { href: route('services', lang), label: t('nav.services') },
  { href: route('projects', lang), label: t('nav.projects') },
  { href: route('about', lang), label: t('nav.about') },
  { href: route('invest', lang), label: t('nav.invest') },
  { href: route('contact', lang), label: t('nav.contact') },
]
const useful = [
  { href: route('references', lang), label: t('refs.title') },
  { href: route('share', lang), label: t('contact.share') },
  { href: route('legal', lang), label: t('legal.title') },
  { href: route('privacy', lang), label: t('privacy.title') },
]
const wa = whatsappLink(t('contact.form.intro'))
const owner = legal.legalName || legal.tradeName
---

<footer class="no-print relative border-t border-line bg-ink pb-12 pt-20 md:pt-28">
  <div class="wrap">
    <div class="grid gap-14 md:grid-cols-12">
      <div class="md:col-span-4">
        <Logo tone="gold" lazy class="h-14 w-auto md:h-16" />
        <p class="mt-6 max-w-sm text-body text-bone/80">{t('site.description')}</p>
        {
          socials.length > 0 && (
            <ul class="mt-8 flex gap-2" aria-label={t('contact.social')}>
              {socials.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} class="flex h-11 w-11 items-center justify-center rounded-full border border-line text-bone/85 transition-colors duration-200 hover:border-gold hover:text-gold">
                    <Icon name={s.key} size={18} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <nav class="md:col-span-2 md:col-start-6" aria-label={lang === 'fr' ? 'Pied de page' : 'Footer'}>
        <p class="meta text-mist">GCG</p>
        <ul class="mt-5 space-y-3">
          {nav.map((n) => <li><a href={n.href} class="link-line text-body text-bone/85 hover:text-bone">{n.label}</a></li>)}
        </ul>
      </nav>

      <div class="md:col-span-3">
        <p class="meta text-mist">{t('footer.links')}</p>
        <ul class="mt-5 space-y-3">
          {useful.map((n) => <li><a href={n.href} class="link-line text-body text-bone/85 hover:text-bone">{n.label}</a></li>)}
          {
            documents.map((d) => (
              <li>
                <a href={d.href} download={d.downloadName} class="group inline-flex items-start gap-2 text-body text-bone/85 hover:text-bone">
                  <Icon name="download" size={16} class="mt-1 shrink-0 text-gold" />
                  <span>
                    <span class="link-line">{lang === 'fr' ? d.title : d.title_en}</span>
                    <span class="block text-small text-bone/70">{documentLabel(d, lang)}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-3">
        <p class="meta text-mist">{t('contact.direct')}</p>
        <ul class="mt-5 space-y-3 text-body text-bone/85">
          {wa && <li><a href={wa} target="_blank" rel="noopener" class="link-line hover:text-bone">WhatsApp {contact.whatsapp}</a></li>}
          {contact.phone && <li><a href={contact.phoneHref} class="link-line hover:text-bone">{contact.phone}</a></li>}
          {contact.email && <li><a href={`mailto:${contact.email}`} class="link-line break-all hover:text-bone">{contact.email}</a></li>}
          {contact.address && <li class="text-bone/80">{contact.address}</li>}
          <li><a href={route('contact', lang)} class="link-line hover:text-bone">{t('cta.project')}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-20 flex flex-col justify-between gap-3 border-t border-line pt-6 md:flex-row">
      <p class="meta text-mist">© {year} {owner} · {t('footer.rights')}</p>
      <p class="meta text-mist">{t('footer.since')} · {t('footer.country')}</p>
    </div>
  </div>
</footer>
