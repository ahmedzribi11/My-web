---
import '../styles/global.css'
import geistUrl from '../fonts/geist-300-600.woff2?url'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import MobileBar from '../components/MobileBar.astro'
import Logo from '../components/Logo.astro'
import { useT, type Lang } from '../i18n'
import { isPreview, pagePath, umamiId, umamiSrc } from '../lib/env'
import { organizationLd } from '../lib/seo'

interface Props {
  lang: Lang
  title?: string
  description?: string
  /** Chemin de la page équivalente dans l’autre langue. */
  alt: string
  /** false si l’autre langue n’a pas d’équivalent exact (lien vers la page parente, sans hreflang). */
  altExact?: boolean
  /** URL (relative ou absolue) de l’image de partage. */
  image?: string
  header?: 'overlay' | 'solid'
  noindex?: boolean
  bare?: boolean
  /** Données structurées propres à la page ; l’accueil ajoute l’organisation. */
  jsonLd?: Record<string, unknown>[]
  organization?: boolean
  /** Titre complet de l’onglet, si le modèle « Page · GCG Côte d’Ivoire » ne suffit pas à le rendre unique. */
  docTitle?: string
}

const { lang, title, description, alt, altExact = true, image = '/og-image.jpg', header = 'solid', noindex = false, bare = false, jsonLd = [], organization = false, docTitle } = Astro.props
const t = useT(lang)
const brand = 'GCG Côte d’Ivoire'
const fullTitle = docTitle ?? (title ? `${title} · ${brand}` : `${brand} · ${t('site.tagline')}`)
const desc = description ?? t('site.description')
const site = Astro.site
const abs = (p: string) => (site ? new URL(p, site).href : p)
const path = pagePath(Astro.url.pathname)
const frPath = lang === 'fr' ? path : alt
const enPath = lang === 'en' ? path : alt
const robots = noindex || isPreview ? 'noindex, nofollow' : ''
const ld = [...(organization ? [organizationLd(lang, site)] : []), ...jsonLd]
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {robots && <meta name="robots" content={robots} />}
    {site && <link rel="canonical" href={abs(path)} />}
    {
      site && altExact && !noindex && (
        <>
          <link rel="alternate" hreflang="fr" href={abs(frPath)} />
          <link rel="alternate" hreflang="en" href={abs(enPath)} />
          <link rel="alternate" hreflang="x-default" href={abs(frPath)} />
        </>
      )
    }
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#052e14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href={lang === 'fr' ? '/manifest.webmanifest' : '/en/manifest.webmanifest'} />
    {site && <link rel="sitemap" href="/sitemap-index.xml" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="General Constructor Group CI" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_GB' : 'fr_FR'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {site && <meta property="og:url" content={abs(path)} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js')
    </script>
    {ld.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : ld)} />}
    {umamiId && !isPreview && <script is:inline defer src={umamiSrc} data-website-id={umamiId} data-do-not-track="true" />}
  </head>
  <body class:list={['min-h-svh', { 'is-bare': bare }]} data-lang={lang}>
    {!bare && <a href="#main" class="skip-link">{t('nav.skip')}</a>}
    <div class="print-only mb-6 border-b border-black pb-3">
      <Logo tone="green" lazy class="h-12 w-auto" />
      <p class="mt-2 text-label">{site ? abs(path) : path}</p>
    </div>
    {!bare && <Header lang={lang} alt={alt} altExact={altExact} variant={header} pageTitle={title} />}
    <main id="main" tabindex="-1">
      <p id="lang-notice" role="status" hidden class="wrap pt-24 text-small text-gold md:pt-28">{t('project.missingEn')}</p>
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}
    {!bare && <MobileBar lang={lang} pageTitle={title} />}
    <script>
      import '../scripts/site'
    </script>
  </body>
</html>
