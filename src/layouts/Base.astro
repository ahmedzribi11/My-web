---
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import '@fontsource/instrument-serif/400-italic.css'
import '@fontsource/instrument-serif/400.css'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import MobileBar from '../components/MobileBar.astro'
import { useT, type Lang } from '../i18n'

interface Props {
  lang: Lang
  title?: string
  description?: string
  /** Chemin de la page équivalente dans l’autre langue. */
  alt: string
  /** URL (relative ou absolue) de l’image de partage. */
  image?: string
  header?: 'overlay' | 'solid'
  noindex?: boolean
  bare?: boolean
  jsonLd?: Record<string, unknown>[]
}

const { lang, title, description, alt, image = '/og-image.jpg', header = 'solid', noindex = false, bare = false, jsonLd = [] } = Astro.props
const t = useT(lang)
const fullTitle = title ? `${title} — GCG` : `GCG — General Constructor Group | ${t('site.tagline')}`
const desc = description ?? t('site.description')
const site = Astro.site
const abs = (p: string) => (site ? new URL(p, site).href : p)
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const frPath = lang === 'fr' ? path : alt
const enPath = lang === 'en' ? path : alt

const org = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: 'General Constructor Group',
  alternateName: ['GCG', 'GCG CI', 'General Constructor Group CI'],
  foundingDate: '2016',
  description: desc,
  areaServed: { '@type': 'Country', name: 'Côte d’Ivoire' },
  address: { '@type': 'PostalAddress', addressCountry: 'CI' },
  knowsAbout: ['Construction', 'Ingénierie', 'Architecture', 'Études de faisabilité', 'VRD', 'Clé en main'],
  ...(site ? { url: site.href, logo: abs('/brand/gcg-logo-green.png') } : {}),
}
---

<!doctype html>
<html lang={lang === 'fr' ? 'fr' : 'en'} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {site && <link rel="canonical" href={abs(path)} />}
    <link rel="alternate" hreflang="fr" href={abs(frPath)} />
    <link rel="alternate" hreflang="en" href={abs(enPath)} />
    <link rel="alternate" hreflang="x-default" href={abs(frPath)} />
    <meta name="theme-color" content="#070c09" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="General Constructor Group CI" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={abs(image)} />
    {site && <meta property="og:url" content={abs(path)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={abs(image)} />

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js')
    </script>
    <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
  </head>
  <body class:list={['grain min-h-svh', { 'is-bare': bare }]} data-lang={lang}>
    {
      !bare && (
        <a
          href="#main"
          class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-gold focus:px-4 focus:py-2 focus:text-brand"
        >
          {t('nav.skip')}
        </a>
      )
    }
    {!bare && <Header lang={lang} alt={alt} variant={header} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}
    {!bare && <MobileBar lang={lang} />}
    {!bare && <div id="cursor" aria-hidden="true" class="pointer-events-none fixed inset-0 z-[95] hidden" />}
    <script>
      import '../scripts/site'
    </script>
  </body>
</html>
