---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { colon, qrPath, route, useT, type Lang, type UIKey } from '../i18n'
import { getProjects } from '../lib/projects'
import { contact, hasContact, pageWhatsApp, socials } from '../lib/settings'
import { contactFormEnabled } from '../lib/env'
import { organizationLd } from '../lib/seo'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
const fr = lang === 'fr'
const projects = await getProjects(lang)
const types = ['villa', 'residence', 'immeuble', 'hotel', 'commerce', 'industrie', 'equipement', 'vrd', 'renovation', 'etude', 'autre'] as const
const wa = pageWhatsApp(lang, t('contact.label'))
const hours = fr ? contact.hours : contact.hours_en
const field =
  'mt-2 w-full rounded-none border-0 border-b border-bone/40 bg-transparent px-0 py-3 text-lead font-light text-bone focus:border-gold focus:outline-none focus:ring-0 aria-[invalid=true]:border-error'
// Fiche « entreprise locale » publiée seulement si une adresse est connue (SEO-07)
const ld = contact.address ? [organizationLd(lang, Astro.site, contact.mapsUrl ? { hasMap: contact.mapsUrl } : {})] : []
---

<Base lang={lang} alt={route('contact', fr ? 'en' : 'fr')} title={fr ? 'Contact' : 'Contact us'} description={t('contact.lead')} jsonLd={ld}>
  <section class="relative overflow-hidden pb-24 pt-32 md:pb-36 md:pt-48">
    <div class="absolute inset-0" aria-hidden="true">
      <div class="css-fog opacity-60"><span></span><span></span><span></span></div>
    </div>
    <div class="wrap relative grid gap-16 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="label text-gold">{t('contact.label')}</p>
        <h1 class="display mt-8 text-display">
          {fr ? 'Parlons de' : 'Let’s talk about'} <em class="serif text-gold">{fr ? 'votre projet.' : 'your project.'}</em>
        </h1>
        <p class="mt-8 max-w-md text-lead text-bone/85">{t('contact.lead')}</p>

        <div class="mt-12 space-y-3">
          {
            wa && (
              <a href={wa} target="_blank" rel="noopener" class="group flex items-center justify-between gap-4 border-b border-line py-4">
                <span class="flex items-center gap-4"><Icon name="whatsapp" size={20} class="text-gold" /><span><span class="meta block text-mist">{t('contact.whatsapp')}</span><span class="text-lead">{contact.whatsapp}</span></span></span>
                <Icon name="arrow-up-right" class="opacity-70 group-hover:opacity-100" />
              </a>
            )
          }
          {
            contact.phone && (
              <a href={contact.phoneHref} class="group flex items-center justify-between gap-4 border-b border-line py-4">
                <span class="flex items-center gap-4"><Icon name="phone" size={20} class="text-gold" /><span><span class="meta block text-mist">{t('contact.phone')}</span><span class="text-lead">{contact.phone}</span></span></span>
                <Icon name="arrow-up-right" class="opacity-70 group-hover:opacity-100" />
              </a>
            )
          }
          {
            contact.email && (
              <a href={`mailto:${contact.email}`} class="group flex items-center justify-between gap-4 border-b border-line py-4">
                <span class="flex items-center gap-4"><Icon name="mail" size={20} class="text-gold" /><span><span class="meta block text-mist">{t('contact.email')}</span><span class="break-all text-lead">{contact.email}</span></span></span>
                <Icon name="arrow-up-right" class="opacity-70 group-hover:opacity-100" />
              </a>
            )
          }
          {
            contact.address && (
              <a href={contact.mapsUrl || undefined} target={contact.mapsUrl ? '_blank' : undefined} rel="noopener" class="group flex items-center justify-between gap-4 border-b border-line py-4">
                <span class="flex items-center gap-4"><Icon name="pin" size={20} class="text-gold" /><span><span class="meta block text-mist">{t('contact.address')}</span><span class="text-lead">{contact.address}</span></span></span>
                {contact.mapsUrl && <Icon name="arrow-up-right" class="opacity-70 group-hover:opacity-100" />}
              </a>
            )
          }
          {
            hours && (
              <p class="flex items-center gap-4 border-b border-line py-4"><Icon name="clock" size={20} class="text-gold" /><span><span class="meta block text-mist">{t('contact.hours')}</span><span class="text-lead">{hours}</span></span></p>
            )
          }
          {!hasContact && <p class="max-w-md border-l border-gold/60 pl-4 text-body text-bone/85">{t('contact.form.pending')}</p>}
        </div>

        {
          socials.length > 0 && (
            <div class="mt-10">
              <p class="meta text-mist">{t('contact.social')}</p>
              <ul class="mt-4 flex gap-2">
                {socials.map((s) => (
                  <li><a href={s.url} target="_blank" rel="noopener" aria-label={s.name} class="flex h-12 w-12 items-center justify-center rounded-full border border-line hover:border-gold hover:text-gold"><Icon name={s.key} size={18} /></a></li>
                ))}
              </ul>
            </div>
          )
        }

        <a href={route('share', lang)} class="mt-12 flex max-w-sm items-center gap-5 rounded-2xl border border-line p-3 pr-6 transition-colors duration-200 hover:border-gold/60">
          <span class="block w-20 shrink-0 rounded-lg bg-white p-1" data-qr={qrPath(lang)} aria-hidden="true"></span>
          <span>
            <span class="meta block text-gold">{t('contact.share')}</span>
            <span class="mt-1 block text-small text-bone/80" data-qr-text={route('home', lang)}></span>
          </span>
        </a>
      </div>

      <div id="formulaire" class="scroll-mt-28 md:col-span-6 md:col-start-7">
        <form id="brief" action="/api/contact" method="post" novalidate data-enabled={contactFormEnabled ? '' : undefined} data-wa={contact.whatsappNumber} data-email={contact.email}>
          <div class="grid gap-x-8 gap-y-8 border border-line bg-ink/80 p-6 md:grid-cols-2 md:p-10">
            <div data-error-summary hidden role="alert" tabindex="-1" class="border-l-2 border-error pl-4 md:col-span-2">
              <p class="text-body text-bone">{t('contact.form.errorsTitle')}</p>
              <ul class="mt-2 list-disc pl-5 text-small text-error"></ul>
            </div>

            <div class="md:col-span-2">
              <label for="f-name" class="meta text-bone/85">{t('contact.form.name')} <span aria-hidden="true">*</span></label>
              <input id="f-name" name="name" required autocomplete="name" maxlength="100" aria-describedby="e-name" class={field} />
              <p id="e-name" data-error-for="name" hidden class="mt-2 text-small text-error"></p>
            </div>
            <p id="contact-hint" class="-mb-4 text-small text-bone/80 md:col-span-2">{t('contact.form.contactHint')}</p>
            <div>
              <label for="f-phone" class="meta text-bone/85">{t('contact.form.phone')}</label>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" aria-describedby="contact-hint e-phone" class={field} />
              <p id="e-phone" data-error-for="phone" hidden class="mt-2 text-small text-error"></p>
            </div>
            <div>
              <label for="f-email" class="meta text-bone/85">{t('contact.form.email')}</label>
              <input id="f-email" name="email" type="email" autocomplete="email" maxlength="254" aria-describedby="contact-hint e-email" class={field} />
              <p id="e-email" data-error-for="email" hidden class="mt-2 text-small text-error"></p>
            </div>
            <div>
              <label for="f-type" class="meta text-bone/85">{t('contact.form.type')} <span class="normal-case tracking-normal text-bone/70">({t('contact.form.optional')})</span></label>
              <select id="f-type" name="type" class={`${field} cursor-pointer`}>
                {types.map((p) => <option value={p} class="bg-ink">{t(`ptype.${p}` as UIKey)}</option>)}
              </select>
            </div>
            <div>
              <label for="f-location" class="meta text-bone/85">{t('contact.form.location')} <span class="normal-case tracking-normal text-bone/70">({t('contact.form.optional')})</span></label>
              <input id="f-location" name="location" autocomplete="address-level2" maxlength="120" placeholder="Abidjan, Grand-Bassam, Assinie…" class={field} />
            </div>
            <div class="md:col-span-2">
              <label for="f-message" class="meta text-bone/85">{t('contact.form.message')} <span class="normal-case tracking-normal text-bone/70">({t('contact.form.optional')})</span></label>
              <textarea id="f-message" name="message" rows="4" maxlength="3000" class={`${field} resize-y`}></textarea>
            </div>

            <input type="hidden" name="lang" value={lang} />
            <input type="hidden" name="t" value="" />
            <input type="hidden" name="profile" value="" />
            <input type="hidden" name="ref" value="" />
            <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
              <label>{t('contact.form.honeypot')} <input name="website" tabindex="-1" autocomplete="off" /></label>
            </div>
            <p data-ref-chip hidden class="text-body text-bone/85 md:col-span-2"></p>

            <div class="flex flex-col gap-3 sm:flex-row md:col-span-2">
              {
                contactFormEnabled && (
                  <button type="submit" value="send" class="btn btn-gold flex-1" data-send>
                    <span data-send-label>{t('contact.form.send')}</span> <Icon name="arrow" />
                  </button>
                )
              }
              {
                contact.whatsappNumber && (
                  <button type="submit" value="whatsapp" formnovalidate class:list={['btn flex-1', contactFormEnabled ? 'btn-line' : 'btn-gold']}>
                    <Icon name="whatsapp" size={18} /> {t('contact.form.sendWhatsapp')}
                  </button>
                )
              }
              {
                !contactFormEnabled && contact.email && (
                  <button type="submit" value="email" class:list={['btn flex-1', contact.whatsappNumber ? 'btn-line' : 'btn-gold']}>
                    <Icon name="mail" size={16} /> {t('contact.form.sendEmail')}
                  </button>
                )
              }
              {
                !contactFormEnabled && !contact.whatsappNumber && !contact.email && (
                  <button type="submit" value="none" class="btn btn-gold flex-1" aria-describedby="brief-pending">
                    {t('cta.project')} <Icon name="arrow" />
                  </button>
                )
              }
            </div>
            <p class="text-small text-bone/80 md:col-span-2">
              {t('contact.form.notice')} <a href={route('privacy', lang)} class="link-line text-gold">{t('contact.form.noticeLink')}</a>
            </p>
            <p id="brief-pending" data-pending hidden class="border-l border-gold/60 pl-4 text-body text-bone/85 md:col-span-2">{t('contact.form.pending')}</p>
            <div data-fail hidden role="alert" class="border-l-2 border-error pl-4 text-body text-bone md:col-span-2">
              <p class="font-medium" data-fail-title>{t('contact.form.failTitle')}</p>
              <p class="mt-1 text-bone/85" data-fail-text>{t('contact.form.failText')}</p>
              <p class="mt-3 flex flex-wrap gap-2">
                {wa && <a href={wa} target="_blank" rel="noopener" class="chip"><Icon name="whatsapp" size={14} /> WhatsApp</a>}
                {contact.phone && <a href={contact.phoneHref} class="chip"><Icon name="phone" size={14} /> {contact.phone}</a>}
                {contact.email && <a href={`mailto:${contact.email}`} class="chip"><Icon name="mail" size={14} /> {contact.email}</a>}
              </p>
            </div>
          </div>
        </form>

        <div data-success hidden role="status" tabindex="-1" class="border border-gold/60 bg-ink/80 p-6 md:p-10">
          <p class="text-title font-light text-gold">{t('contact.form.okTitle')}</p>
          <p class="mt-4 text-body text-bone/85">{t('contact.form.okText')}</p>
          <p class="mt-4 flex flex-wrap gap-2">
            {wa && <a href={wa} target="_blank" rel="noopener" class="chip"><Icon name="whatsapp" size={14} /> WhatsApp</a>}
            {contact.phone && <a href={contact.phoneHref} class="chip"><Icon name="phone" size={14} /> {contact.phone}</a>}
            <a href={route('projects', lang)} class="chip">{t('cta.allProjects')}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <script id="brief-data" type="application/json" set:html={JSON.stringify({
    projects: Object.fromEntries(projects.map((p) => [p.slug, p.name])),
    labels: {
      intro: t('contact.form.intro'),
      name: t('contact.form.name'),
      phone: t('contact.form.phone'),
      email: t('contact.form.email'),
      profile: t('contact.form.profile'),
      type: t('contact.form.type'),
      location: t('contact.form.location'),
      message: t('contact.form.message'),
      colon: colon(lang),
      ref: fr ? 'Projet de référence' : 'Reference project',
      subject: fr ? 'Demande de projet — site GCG' : 'Project enquiry — GCG website',
      sending: t('contact.form.sending'),
      rate: t('contact.form.rate'),
      errName: t('contact.form.err.name'),
      errContact: t('contact.form.err.contact'),
      errPhone: t('contact.form.err.phone'),
      errEmail: t('contact.form.err.email'),
    },
  })} />
<script>
  import '../scripts/qr'
  import { track } from '../scripts/analytics'

  const form = document.getElementById('brief') as HTMLFormElement
  const data = JSON.parse(document.getElementById('brief-data')!.textContent!) as { projects: Record<string, string>; labels: Record<string, string> }
  const L = data.labels
  const params = new URLSearchParams(location.search)
  const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement
  input('t').value = String(Date.now())

  // Préremplissage depuis un projet ou un public cible (?projet=…, ?profil=…)
  const profileMap: Record<string, string> = { investisseurs: 'investisseur', hotellerie: 'hotelier', diaspora: 'diaspora', entreprises: 'entreprise' }
  const profil = params.get('profil')
  if (profil && profileMap[profil]) input('profile').value = profileMap[profil]
  const ref = params.get('projet')
  if (ref && data.projects[ref]) {
    input('ref').value = ref
    const chip = form.querySelector<HTMLElement>('[data-ref-chip]')!
    chip.hidden = false
    chip.textContent = `${L.ref}${L.colon}${data.projects[ref]}`
  }

  /* Validation dans la langue de la page, erreurs annoncées et reliées aux champs (A11Y-08) */
  const summary = form.querySelector<HTMLElement>('[data-error-summary]')!
  function validate() {
    const errs: [string, string][] = []
    const name = input('name').value.trim()
    const phone = input('phone').value.trim()
    const email = input('email').value.trim()
    if (name.length < 2) errs.push(['name', L.errName])
    if (!phone && !email) errs.push(['phone', L.errContact])
    else {
      if (phone && !/^\+?[\d\s().-]{8,30}$/.test(phone)) errs.push(['phone', L.errPhone])
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) errs.push(['email', L.errEmail])
    }
    for (const n of ['name', 'phone', 'email']) {
      const e = errs.find(([k]) => k === n)
      input(n).setAttribute('aria-invalid', String(Boolean(e)))
      const p = form.querySelector<HTMLElement>(`[data-error-for="${n}"]`)!
      p.hidden = !e
      p.textContent = e ? e[1] : ''
    }
    const list = summary.querySelector('ul')!
    list.replaceChildren(
      ...errs.map(([k, msg]) => {
        const li = document.createElement('li')
        const a = document.createElement('a')
        a.href = `#f-${k}`
        a.textContent = msg
        a.className = 'underline'
        li.append(a)
        return li
      }),
    )
    summary.hidden = errs.length === 0
    if (errs.length) summary.focus()
    return errs.length === 0
  }

  function message() {
    const sel = (name: string) => {
      const el = form.elements.namedItem(name) as HTMLSelectElement
      return el.options[el.selectedIndex]?.text ?? ''
    }
    const f = new FormData(form)
    const refSlug = String(f.get('ref') || '')
    return [
      L.intro,
      '',
      `${L.name}${L.colon}${f.get('name')}`,
      f.get('phone') ? `${L.phone}${L.colon}${f.get('phone')}` : '',
      f.get('email') ? `${L.email}${L.colon}${f.get('email')}` : '',
      `${L.type}${L.colon}${sel('type')}`,
      f.get('location') ? `${L.location}${L.colon}${f.get('location')}` : '',
      refSlug ? `${L.ref} : ${data.projects[refSlug]} (${location.origin}${document.body.dataset.lang === 'en' ? '/en/projects/' : '/realisations/'}${refSlug})` : '',
      f.get('message') ? `\n${L.message} :\n${f.get('message')}` : '',
    ]
      .filter(Boolean)
      .join('\n')
  }

  const fail = form.querySelector<HTMLElement>('[data-fail]')!
  const failText = fail.querySelector<HTMLElement>('[data-fail-text]')!
  const failDefault = failText.textContent
  const sendBtn = form.querySelector<HTMLButtonElement>('[data-send]')
  const sendLabel = sendBtn?.querySelector<HTMLElement>('[data-send-label]')

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const via = (e.submitter as HTMLButtonElement | null)?.value ?? 'send'
    fail.hidden = true
    if (via === 'none') {
      form.querySelector<HTMLElement>('[data-pending]')!.hidden = false
      return
    }
    if (!validate()) return
    if (via === 'whatsapp' && form.dataset.wa) {
      track('whatsapp', { from: 'form' })
      window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(message())}`, '_blank', 'noopener')
      return
    }
    if (via === 'email' && form.dataset.email) {
      track('email', { from: 'form' })
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(L.subject)}&body=${encodeURIComponent(message())}`
      return
    }
    // Envoi au service de formulaire ; en cas d’échec, les données restent saisies
    const prevLabel = sendLabel?.textContent
    if (sendBtn) sendBtn.disabled = true
    if (sendLabel) sendLabel.textContent = L.sending
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      })
      const body = (await res.json().catch(() => ({}))) as { ok?: boolean; code?: string }
      if (!res.ok || !body.ok) throw new Error(body.code || String(res.status))
      track('form')
      form.hidden = true
      const ok = document.querySelector<HTMLElement>('[data-success]')!
      ok.hidden = false
      ok.focus()
    } catch (err) {
      failText.textContent = (err as Error).message === 'rate' ? L.rate : failDefault
      fail.hidden = false
      fail.scrollIntoView({ block: 'nearest' })
    } finally {
      if (sendBtn) sendBtn.disabled = false
      if (sendLabel && prevLabel) sendLabel.textContent = prevLabel
    }
  })
</script>
</Base>
