---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import ProjectImage from '../components/ProjectImage.astro'
import Icon from '../components/Icon.astro'
import { projectPath, qrPath, route, useT, type Lang, type QrMedium } from '../i18n'
import { getProjects, pad } from '../lib/projects'
import { documents, documentLabel, socials } from '../lib/settings'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useT(lang)
const fr = lang === 'fr'
const projects = await getProjects(lang)
const home = route('home', lang)
const media: { id: QrMedium; label: string }[] = [
  { id: 'panneau', label: fr ? 'Panneau de chantier' : 'Site hoarding' },
  { id: 'carte', label: fr ? 'Carte de visite' : 'Business card' },
  { id: 'brochure', label: fr ? 'Brochure' : 'Brochure' },
]
---

<Base lang={lang} alt={route('share', fr ? 'en' : 'fr')} title={t('share.label')} description={t('share.lead')}>
  <PageHeader label={t('share.label')} title={t('share.title')} accent={fr ? 'un scan.' : 'one scan.'} lead={t('share.lead')} />

  <section class="wrap pb-6">
    <p data-qr-warning hidden role="note" class="flex items-start gap-3 border border-gold/60 p-4 text-body text-gold">
      <Icon name="print" size={18} class="mt-1 shrink-0" />
      {t('share.tempWarning')}
    </p>
  </section>

  <section class="wrap grid gap-6 pb-20 md:grid-cols-12">
    <!-- QR du site, un par support (mesure des scans par support) -->
    <article class="flex flex-col gap-8 border border-line bg-ink-2 p-6 md:col-span-7 md:flex-row md:p-10" data-reveal>
      <div id="qr-site" class="mx-auto w-full max-w-[280px] shrink-0 self-start rounded-xl bg-white p-3 md:mx-0" data-qr={qrPath(lang, 'panneau')}></div>
      <div class="flex flex-col justify-between gap-8">
        <div>
          <h2 class="meta text-gold">{t('share.site')}</h2>
          <p class="mt-4 break-all text-title font-light" data-qr-text={home}></p>
          <p class="mt-3 text-body text-bone/80">{t('share.siteHelp')}</p>
          <fieldset class="mt-6">
            <legend class="meta text-mist">{fr ? 'Support imprimé' : 'Printed medium'}</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {
                media.map((m, i) => (
                  <label class="chip cursor-pointer has-[:checked]:border-bone has-[:checked]:bg-bone has-[:checked]:text-ink">
                    <input type="radio" name="qr-medium" value={qrPath(lang, m.id)} data-name={`gcg-qr-${m.id}`} class="sr-only" checked={i === 0} />
                    {m.label}
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="chip" data-qr-download="qr-site" data-qr-name="gcg-qr-panneau"><Icon name="download" size={14} /> {t('share.download')}</button>
          <button type="button" class="chip" data-qr-download="qr-site" data-format="png" data-qr-name="gcg-qr-panneau"><Icon name="download" size={14} /> {t('share.downloadPng')}</button>
          <button type="button" class="chip" data-copy={home} data-copied={t('project.copied')}><Icon name="link" size={14} /> <span data-copy-label>{t('share.copy')}</span></button>
          <button type="button" class="chip" data-share={home} data-title="GCG — General Constructor Group" data-copied={t('project.copied')}><Icon name="share" size={14} /> <span data-copy-label>{t('share.native')}</span></button>
        </div>
      </div>
    </article>

    <!-- Affiche -->
    <a href={route('poster', lang)} class="group flex flex-col justify-between gap-8 border border-line bg-brand p-6 transition-colors duration-200 hover:border-gold md:col-span-5 md:p-10" data-reveal>
      <div class="flex items-start justify-between gap-6">
        <div>
          <h2 class="meta text-gold">{t('share.poster')}</h2>
          <p class="mt-4 max-w-xs text-body text-bone/85">{t('share.posterHelp')}</p>
        </div>
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-gold/50 text-gold transition-colors duration-200 group-hover:bg-gold group-hover:text-brand"><Icon name="print" size={18} /></span>
      </div>
      <div class="mx-auto flex aspect-[210/297] w-40 flex-col items-center justify-between bg-brand-2 p-4 shadow-2xl ring-1 ring-gold/30" aria-hidden="true">
        <img src="/brand/gcg-logo-gold-440.webp" alt="" width="440" height="133" class="h-5 w-auto" loading="lazy" />
        <span class="block w-20 rounded bg-white p-1" data-qr={qrPath(lang, 'panneau')}></span>
        <span class="text-center text-label uppercase tracking-[0.2em] text-gold">{t('poster.scan')}</span>
      </div>
      <span class="meta inline-flex items-center gap-2 text-bone">{t('share.posterOpen')} <Icon name="arrow" /></span>
    </a>

    {
      documents.length > 0 && (
        <article class="border border-line p-6 md:col-span-12 md:p-10" data-reveal>
          <h2 class="meta text-gold">{t('share.pdf')}</h2>
          <ul class="mt-6 grid gap-3 md:grid-cols-2">
            {documents.map((d) => (
              <li>
                <a href={d.href} download={d.downloadName} class="group flex items-center justify-between gap-6 border border-line p-5 transition-colors duration-200 hover:border-gold">
                  <span>
                    <span class="block text-lead">{fr ? d.title : d.title_en}</span>
                    <span class="mt-1 block text-small text-bone/80">{documentLabel(d, lang)}</span>
                  </span>
                  <Icon name="download" size={18} class="shrink-0 text-gold" />
                </a>
              </li>
            ))}
          </ul>
        </article>
      )
    }

    <!-- Réseaux sociaux -->
    <article class="border border-line p-6 md:col-span-12 md:p-10" data-reveal>
      <h2 class="meta text-gold">{t('share.social')}</h2>
      {
        socials.length > 0 ? (
          <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
            {socials.map((s) => (
              <li class="flex flex-col items-center gap-3 border border-line p-4">
                <span id={`qr-${s.key}`} class="block w-full max-w-[160px] rounded-lg bg-white p-2" data-qr={`/qr/${s.key}`} />
                <a href={s.url} target="_blank" rel="noopener" class="flex items-center gap-2 text-body hover:text-gold">
                  <Icon name={s.key} size={16} /> {s.name}
                </a>
                <button type="button" class="meta inline-flex min-h-11 items-center text-bone/85 hover:text-gold" data-qr-download={`qr-${s.key}`} data-format="png" data-qr-name={`gcg-qr-${s.key}`}>{t('share.downloadPng')}</button>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4 max-w-xl text-body text-bone/80">{t('share.socialPending')}</p>
        )
      }
    </article>
  </section>

  <!-- QR par projet -->
  <section class="wrap pb-28 md:pb-40" aria-labelledby="qr-projects">
    <div class="grid gap-6 border-t border-line pt-14 md:grid-cols-12 md:items-end">
      <h2 id="qr-projects" class="display text-display md:col-span-7">{t('share.projects')}</h2>
      <p class="text-body text-bone/80 md:col-span-5" data-reveal>{t('share.projectsHelp')}</p>
    </div>
    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        projects.map((p) => (
          <li class="flex gap-4 border border-line p-3">
            <span id={`qr-p-${p.slug}`} class="block w-24 shrink-0 self-start rounded bg-white p-1" data-qr={qrPath(lang, 'panneau', p.slug)} />
            <div class="flex min-w-0 flex-1 flex-col justify-between gap-2">
              <div class="flex items-start gap-3">
                <ProjectImage image={p.images[0]} alt="" sizes="2.5rem" class="block h-10 w-10 shrink-0 overflow-hidden rounded" />
                <a href={projectPath(p.slug, lang)} class="min-w-0 text-small hover:text-gold">
                  <span class="meta block text-mist">N° {pad(p.number)}</span>
                  {p.name}
                </a>
              </div>
              <div class="flex flex-wrap gap-x-4">
                <button type="button" class="meta inline-flex min-h-11 items-center text-bone/85 hover:text-gold" data-qr-download={`qr-p-${p.slug}`} data-format="png" data-qr-name={`gcg-qr-${p.slug}`}>PNG</button>
                <button type="button" class="meta inline-flex min-h-11 items-center text-bone/85 hover:text-gold" data-qr-download={`qr-p-${p.slug}`} data-qr-name={`gcg-qr-${p.slug}`}>SVG</button>
                <a href={`${route('poster', lang)}?p=${p.slug}`} class="meta inline-flex min-h-11 items-center text-bone/85 hover:text-gold">{t('project.poster')}</a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
<script>
  import { renderQrs } from '../scripts/qr'

  const site = document.getElementById('qr-site')
  document.querySelectorAll<HTMLInputElement>('input[name="qr-medium"]').forEach((r) =>
    r.addEventListener('change', () => {
      if (!site || !r.checked) return
      site.dataset.qr = r.value
      document.querySelectorAll<HTMLElement>('[data-qr-download="qr-site"]').forEach((b) => (b.dataset.qrName = r.dataset.name))
      renderQrs(site.parentElement!)
    }),
  )
</script>
</Base>
