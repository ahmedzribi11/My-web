---
import { getImage } from 'astro:assets'
import Base from '../layouts/Base.astro'
import ProjectImage from '../components/ProjectImage.astro'
import ProjectCard from '../components/ProjectCard.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import Icon from '../components/Icon.astro'
import { getService } from '../data/services'
import { projectPath, qrPath, route, SECTOR_LABELS, servicePath, STATUS_LABELS, useT, type Lang } from '../i18n'
import { pad, type Project } from '../lib/projects'
import { pageWhatsApp } from '../lib/settings'
import { breadcrumbLd } from '../lib/seo'

interface Props {
  lang: Lang
  project: Project
  all: Project[]
}
const { lang, project: p, all } = Astro.props
const t = useT(lang)
const idx = all.findIndex((x) => x.slug === p.slug)
const prev = all[(idx - 1 + all.length) % all.length]
const next = all[(idx + 1) % all.length]
const related = all
  .filter((x) => x.slug !== p.slug && (x.sector === p.sector || x.types.some((ty) => p.types.includes(ty))))
  .sort((a, b) => Number(b.sector === p.sector) - Number(a.sector === p.sector) || Math.abs(a.number - p.number) - Math.abs(b.number - p.number))
  .slice(0, 3)
const og = await getImage({ src: p.images[0].src, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 72 })
const sheet: [string, string | undefined][] = [
  [t('project.location'), p.location],
  [t('project.period'), p.period],
  [t('project.surface'), p.surface],
  [t('project.terrain'), p.terrain],
  [t('project.covered'), p.coveredSurface],
  [t('project.sector'), SECTOR_LABELS[p.sector][lang]],
  [t('project.status'), p.status ? STATUS_LABELS[p.status][lang] : undefined],
]
const path = projectPath(p.slug, lang)
// Version dans l’autre langue : page projet si la version anglaise est relue, sinon liste des projets
const altExact = lang === 'en' || p.hasEn
const alt = altExact ? projectPath(p.slug, lang === 'fr' ? 'en' : 'fr') : route('projects', 'en')
const kindLabel = (k: string) => (k === 'render' ? t('project.render') : k === 'plan' ? t('project.plan') : '')
/** Mise en page de la galerie : une grande image, deux petites, puis des rangées pleines. */
function galleryClass(i: number, n: number) {
  if (n === 1) return 'md:col-span-6'
  if (n === 2) return 'md:col-span-3'
  if (i === 0) return 'md:col-span-4 md:row-span-2'
  if (i < 3) return 'md:col-span-2'
  const rest = n - 3
  return rest % 2 === 1 && i === n - 1 ? 'md:col-span-6' : 'md:col-span-3'
}
const wa = pageWhatsApp(lang, p.name)
const desc = p.seoDescription ?? `${p.composition} ${p.location}, ${p.period}.`
/** Titre d’onglet et de résultat Google : ≈ 60 caractères au plus (SEO-03). */
const titleBase = p.seoTitle ?? p.name
const titleLong = `${titleBase} · ${lang === 'fr' ? 'projet GCG, Côte d’Ivoire' : 'GCG project, Côte d’Ivoire'}`
const docTitle = titleLong.length <= 60 ? titleLong : `${titleBase} · GCG`
const crumbs = [
  { name: t('nav.home'), path: route('home', lang) },
  { name: t('projects.label'), path: route('projects', lang) },
  { name: p.name, path },
]
---

<Base lang={lang} alt={alt} altExact={altExact} title={p.name} docTitle={docTitle} description={desc} image={og.src} header="overlay" jsonLd={[breadcrumbLd(crumbs, Astro.site)]}>
  <article>
    <header class="relative flex min-h-[560px] items-end overflow-hidden bg-ink-3 md:h-[86svh]">
      <ProjectImage image={p.images[0]} sizes="100vw" priority class="absolute inset-0 block h-full w-full" vt={`p-${p.slug}`} />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-ink/50"></div>
      <div class="wrap relative pb-10 pt-28 md:pb-16">
        <Breadcrumb items={crumbs} />
        <h1 class="display mt-6 max-w-[16ch] text-display">{p.name}</h1>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          {p.status && <span class="pill" data-status={p.status}>{STATUS_LABELS[p.status][lang]}</span>}
          {p.images[0].kind !== 'photo' && <span class="pill" data-kind={p.images[0].kind}>{kindLabel(p.images[0].kind)}</span>}
          <span class="flex items-center gap-2 text-body text-bone/90"><Icon name="pin" size={16} class="text-gold" />{p.location}</span>
          <span class="flex items-center gap-2 text-body text-bone/90"><Icon name="clock" size={16} class="text-gold" />{p.period}</span>
          {p.surface && <span class="text-body text-bone/90">{p.surface}</span>}
        </div>
      </div>
    </header>

    <div class="wrap grid gap-16 py-16 md:py-28 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="label text-gold">{t('project.composition')}</h2>
        <p class="mt-6 text-title font-light tracking-[-0.02em]">{p.composition}</p>
        {p.typology && <p class="mt-6 text-lead text-bone/80"><span class="meta mr-3 text-mist">{t('project.typology')}</span>{p.typology}</p>}

        <h2 class="label mt-16 text-gold">{t('project.missions')}</h2>
        <ol class="mt-6 border-t border-line">
          {
            p.missions.map((m, i) => (
              <li class="flex gap-6 border-b border-line py-5 text-lead font-light">
                <span class="meta pt-1.5 text-mist">{pad(i + 1)}</span>
                {m}
              </li>
            ))
          }
        </ol>

        {
          p.typologies && (
            <>
              <h2 class="label mt-16 text-gold">{t('project.typologies')}</h2>
              <table class="mt-6 w-full border-t border-line text-left">
                <thead class="sr-only">
                  <tr>
                    <th scope="col">{t('project.typology')}</th>
                    <th scope="col">{t('project.surface')}</th>
                  </tr>
                </thead>
                <tbody>
                  {p.typologies.map((ty) => (
                    <tr class="border-b border-line">
                      <td class="py-5 text-lead font-light">{ty.name}</td>
                      <td class="meta py-5 text-right text-gold">{ty.surface}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )
        }

        {
          p.services.length > 0 && (
            <>
              <h2 class="label mt-16 text-gold">{t('project.services')}</h2>
              <ul class="mt-6 flex flex-wrap gap-2">
                {p.services.map((id) => {
                  const s = getService(id)
                  return (
                    <li>
                      <a href={servicePath(s.slug[lang], lang)} class="chip">{s.title[lang]}</a>
                    </li>
                  )
                })}
              </ul>
            </>
          )
        }
      </div>

      <aside class="lg:col-span-4 lg:col-start-9">
        <div class="border border-bone/30 bg-ink-2">
          <div class="flex items-center justify-between bg-brand px-5 py-3">
            <h2 class="meta text-gold">{t('project.sheet')}</h2>
            <span class="meta text-gold">N° {pad(p.number)}</span>
          </div>
          <p class="border-b border-line px-5 py-4 text-lead font-light">{p.name}</p>
          <dl class="grid grid-cols-[auto_1fr]">
            {
              sheet
                .filter(([, v]) => v)
                .map(([k, v]) => (
                  <>
                    <dt class="meta border-b border-r border-line px-5 py-3.5 text-mist">{k}</dt>
                    <dd class="border-b border-line px-5 py-3.5 text-body">{v}</dd>
                  </>
                ))
            }
          </dl>
          <div class="flex items-end justify-between gap-4 px-5 py-4">
            <span class="meta text-mist">General Constructor Group CI</span>
            <img src="/brand/gcg-logo-gold-440.webp" alt="" width="440" height="133" class="h-6 w-auto opacity-80" loading="lazy" />
          </div>
        </div>

        <div class="mt-6 border border-line p-5" data-share-box>
          <h2 class="meta text-gold">{t('project.share')}</h2>
          <div class="mt-4 flex gap-4">
            <span id="project-qr" class="block w-24 shrink-0 self-start rounded bg-white p-1" data-qr={qrPath(lang, 'panneau', p.slug)}></span>
            <div class="flex flex-col gap-2">
              <button type="button" class="chip" data-share={path} data-title={`${p.name} · GCG`} data-copied={t('project.copied')}>
                <Icon name="share" size={14} /> <span data-copy-label>{t('cta.share')}</span>
              </button>
              <button type="button" class="chip" data-copy={path} data-copied={t('project.copied')}>
                <Icon name="link" size={14} /> <span data-copy-label>{t('project.copy')}</span>
              </button>
              <a href={`${route('poster', lang)}?p=${p.slug}`} class="chip"><Icon name="print" size={14} /> {t('project.poster')}</a>
            </div>
          </div>
          <p class="mt-4 text-small text-bone/75">{t('project.qrHelp')}</p>
        </div>
      </aside>
    </div>

    <section class="wrap pb-20 md:pb-28" aria-labelledby="gallery-title">
      <h2 id="gallery-title" class="label text-gold">{t('project.gallery')}</h2>
      <ul class="mt-8 grid gap-3 md:grid-cols-6">
        {
          p.images.map((img, i) => (
            <li class:list={['flex flex-col', galleryClass(i, p.images.length)]}>
              <button type="button" class="group relative block h-full overflow-hidden bg-ink-3 text-left" data-lightbox={i} aria-haspopup="dialog">
                <ProjectImage image={img} alt="" sizes={i === 0 && p.images.length > 2 ? '(min-width: 768px) 66vw, 100vw' : '(min-width: 768px) 50vw, 100vw'} class="block aspect-[4/3] h-full w-full" imgClass="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
                {img.kind !== 'photo' && <span class="pill absolute left-3 top-3" data-kind={img.kind}>{kindLabel(img.kind)}</span>}
                <span class="sr-only">{`${t('project.enlarge')} : ${img.alt}`}</span>
              </button>
              <p class="mt-2 text-small text-bone/75">{img.alt}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <dialog id="lightbox" class="lightbox m-0 h-full max-h-none w-full max-w-none bg-ink/95 p-0 text-bone backdrop:bg-ink/90" aria-label={t('project.gallery')}>
      <div class="relative flex h-full w-full items-center justify-center">
        {
          p.images.map((img, i) => (
            <figure data-slide={i} hidden class="flex h-full w-full flex-col items-center justify-center gap-4 p-4 pb-20 md:p-16">
              <ProjectImage image={img} sizes="100vw" class="block max-h-full" imgClass="max-h-[74svh] w-auto max-w-full object-contain" />
              <figcaption class="max-w-2xl text-center text-small text-bone/85">
                {img.kind !== 'photo' && <span class="meta mr-2 text-gold">{kindLabel(img.kind)}</span>}
                {img.alt}
              </figcaption>
            </figure>
          ))
        }
        <p class="meta absolute left-5 top-5 text-bone/85" aria-live="polite"><span class="sr-only">{t('project.photo')} </span><span data-lb-index>1</span> / {p.images.length}</p>
        <button type="button" class="absolute right-4 top-4 flex h-12 w-12 items-center justify-center rounded-full border border-line hover:border-gold" data-lb-close aria-label={t('project.close')}><Icon name="close" size={18} /></button>
        {
          p.images.length > 1 && (
            <>
              <button type="button" class="absolute bottom-4 left-4 flex h-12 w-12 items-center justify-center rounded-full border border-line bg-ink/60 hover:border-gold md:bottom-auto md:top-1/2 md:-translate-y-1/2" data-lb-prev aria-label={t('project.prevPhoto')}><Icon name="arrow-left" size={18} /></button>
              <button type="button" class="absolute bottom-4 right-4 flex h-12 w-12 items-center justify-center rounded-full border border-line bg-ink/60 hover:border-gold md:bottom-auto md:top-1/2 md:-translate-y-1/2" data-lb-next aria-label={t('project.nextPhoto')}><Icon name="arrow" size={18} /></button>
            </>
          )
        }
      </div>
    </dialog>

    <section class="theme-paper py-20 md:py-28 no-print">
      <div class="wrap flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
        <div>
          <p class="label text-brand/75">{t('project.similar')}</p>
          <h2 class="display mt-6 max-w-[18ch] text-display">{t('project.similarText')}</h2>
        </div>
        <div class="flex flex-wrap gap-3">
          {wa && <a href={wa} target="_blank" rel="noopener" class="btn btn-dark"><Icon name="whatsapp" size={16} /> WhatsApp</a>}
          <a href={`${route('contact', lang)}?projet=${p.slug}`} class:list={['btn', wa ? 'btn-line-dark' : 'btn-dark']}>{t('cta.project')} <Icon name="arrow" /></a>
        </div>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="wrap py-20 md:py-28 no-print" aria-labelledby="related-title">
          <h2 id="related-title" class="label text-gold">{t('project.related')}</h2>
          <div class="mt-10 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => <ProjectCard project={r} lang={lang} />)}
          </div>
        </section>
      )
    }

    <nav class="grid border-t border-line md:grid-cols-2 no-print" aria-label={lang === 'fr' ? 'Projets voisins' : 'Adjacent projects'}>
      <a href={projectPath(prev.slug, lang)} class="group block border-b border-line px-5 py-12 md:border-b-0 md:border-r md:px-10 md:py-16">
        <span class="meta flex items-center gap-2 text-mist"><Icon name="arrow-left" /> {t('project.prev')}</span>
        <span class="mt-4 block text-title font-light text-bone/75 transition-colors duration-200 group-hover:text-bone">{prev.name}</span>
      </a>
      <a href={projectPath(next.slug, lang)} class="group block px-5 py-12 text-right md:px-10 md:py-16">
        <span class="meta flex items-center justify-end gap-2 text-mist">{t('project.next')} <Icon name="arrow" /></span>
        <span class="mt-4 block text-title font-light text-bone/75 transition-colors duration-200 group-hover:text-bone">{next.name}</span>
      </a>
    </nav>
  </article>
<script>
  import '../scripts/qr'
  import { lockScroll } from '../scripts/site'

  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null
  if (dlg) {
    const slides = Array.from(dlg.querySelectorAll<HTMLElement>('[data-slide]'))
    const label = dlg.querySelector<HTMLElement>('[data-lb-index]')!
    let i = 0
    let opener: HTMLElement | null = null
    const show = (n: number) => {
      i = (n + slides.length) % slides.length
      slides.forEach((s, k) => (s.hidden = k !== i))
      label.textContent = String(i + 1)
    }
    const open = (n: number, from: HTMLElement) => {
      opener = from
      show(n)
      dlg.showModal()
      lockScroll(true)
      // Le bouton « retour » d’Android ferme la visionneuse au lieu de quitter la page
      history.pushState({ lightbox: true }, '')
    }
    document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((b) => b.addEventListener('click', () => open(Number(b.dataset.lightbox), b)))
    dlg.addEventListener('close', () => {
      lockScroll(false)
      if (history.state?.lightbox) history.back()
      opener?.focus()
    })
    addEventListener('popstate', () => {
      if (dlg.open) dlg.close()
    })
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close())
    dlg.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(i - 1))
    dlg.querySelector('[data-lb-next]')?.addEventListener('click', () => show(i + 1))
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1)
      if (e.key === 'ArrowRight') show(i + 1)
    })
    let x0: number | null = null
    dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true })
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return
      const dx = e.changedTouches[0].clientX - x0
      if (Math.abs(dx) > 50 && slides.length > 1) show(i + (dx < 0 ? 1 : -1))
      x0 = null
    })
  }
</script>
</Base>
<style>
  .lightbox[open] { display: block; }
</style>
